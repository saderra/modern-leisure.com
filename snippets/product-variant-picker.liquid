{% comment %}
  Renders product variant-picker

  Accepts:
  - product: {Object} product object.
  - block: {Object} passing the block information.
  - product_form_id: {String} Id of the product form to which the variant picker is associated.
  - update_url: {Boolean} whether or not to update url when changing variants. If false, the url isn't updated. Default: true (optional).
  Usage:
  {% render 'product-variant-picker', product: product, block: block, product_form_id: product_form_id %}
{% endcomment %}
{%- unless product.has_only_default_variant -%}
  {% liquid
    assign size_option_name = block.settings.size_title | downcase
    assign size_chart = product.metafields.foxtheme.size_chart
    assign size_chart_modal_id = 'SizeChartModal-' | append: block.id

    case size_chart.type
      when 'file_reference'
        assign size_chart_alt = size_chart.value.alt | default: ''
        assign size_chart_content = size_chart | image_url: width: size_chart.width | image_tag: alt: size_chart_alt, loading: 'lazy', fetchpriority: 'low', class: 'motion-reduce', is: 'image-lazy'
      when 'page_reference'
        assign size_chart_content = size_chart.value.content
      else
        assign size_chart_content = size_chart
    endcase

    if size_chart_content == blank and block.settings.size_chart_from_page != blank
      assign size_chart_content = pages[block.settings.size_chart_from_page].content
    endif
  %}
  <script src="{{ 'variant-selects.js' | asset_url }}" defer="defer"></script>
  <variant-selects
    id="variant-selects-{{ section.id }}"
    data-section="{{ section.id }}"
    data-url="{{ product.url }}"
    data-update-url="{% if update_url == false %}false{% else %}true{% endif %}"
  >
    {%- for option in product.options_with_values -%}
      {%- liquid
        assign option_name_downcase = option.name | downcase
        assign swatch_count = option.values | map: 'swatch' | compact | size
        assign picker_type = block.settings.picker_type

        assign attach_size_chart = false
        if size_option_name contains option_name_downcase
          assign attach_size_chart = true
        endif

        if block.settings.picker_type == 'button' and settings.color_swatch_trigger != blank
          assign color_swatch_trigger = settings.color_swatch_trigger | downcase | split: ','
          assign has_color = color_swatch_trigger | where: option_name_downcase | first
          unless block.settings.swatch_type == 'text'
            if has_color != blank
              assign picker_type = 'color'
            elsif option_name_downcase contains 'colour'
              assign color_swatch_trigger = color_swatch_trigger | replace: 'color', 'colour'
              assign has_color = color_swatch_trigger | where: option_name_downcase | first
              if has_color != blank
                assign picker_type = 'color'
              endif
            endif
          endunless
        endif

        if swatch_count > 0
          if block.settings.picker_type == 'dropdown'
            assign picker_type = 'swatch_dropdown'
          else
            if block.settings.swatch_type == 'shopify_swatch'
              assign picker_type = 'swatch'
            elsif block.settings.swatch_type == 'variant_image' or block.settings.swatch_type == 'color_swatch'
              assign picker_type = 'color'
            else
              assign picker_type = 'button'
            endif
          endif
        endif

        assign wrap_class = 'product-form__input product-form__input--' | append: picker_type
        case picker_type
          when 'swatch', 'color', 'button'
            assign is_fieldset_tag = true
            assign wrap_class = wrap_class | append: ' js flex flex-wrap'
            assign button_style = block.settings.button_style | default: 'standard'

            if picker_type == 'button'
              assign wrap_class = wrap_class | append: ' gap-3'
              assign wrap_class = wrap_class | append: ' product-form__input--button-' | append: button_style
            else
              assign wrap_class = wrap_class | append: ' gap-4'
              assign wrap_class = wrap_class | append: ' product-form__input--button-' | append: button_style
            endif
          else
            assign is_fieldset_tag = false
        endcase

        assign tag_fieldset = 'fieldset'
        assign tag_legend = 'legend'
        unless is_fieldset_tag
          assign tag_fieldset = 'div'
          assign tag_legend = 'label'
        endunless
      -%}
      <{{ tag_fieldset }}
        class="{{ wrap_class }}"
        {% if picker_type == 'color' %}
          data-swatch-type="{{ block.settings.swatch_type }}"
        {% endif %}
        style="--swatch-size: {{ block.settings.button_size | default: '40px' }}px;"
      >
        <{{ tag_legend }}
          {% unless is_fieldset_tag %}
            for="Option-{{ section.id }}-{{ forloop.index0 }}"
          {% endunless %}
          class="form__label"
        >
          <div class="flex flex-wrap gap-2">
            <span class="font-body-bold">{{ option.name }}:</span>
            <span data-selected-swatch-value="{{ option.name }}">
              {{- option.selected_value -}}
            </span>
          </div>
          {%- if size_chart_content != blank and attach_size_chart -%}
            <button
              class="open-size-chart no-js-hidden btn--link tracking-normal"
              aria-controls="{{ size_chart_modal_id }}"
              aria-haspopup="dialog"
            >
              {{ 'products.product.open_size_chart' | t }}
            </button>
          {%- endif -%}
        </{{ tag_legend }}>
        {%- case picker_type -%}
          {%- when 'swatch', 'color', 'button' -%}
            {% render 'product-variant-options',
              product: product,
              option: option,
              block: block,
              picker_type: picker_type
            %}
          {%- else -%}
            <div class="select">
              {%- if picker_type == 'swatch_dropdown' -%}
                <span
                  data-selected-value
                  class="dropdown-swatch"
                >
                  {% comment %} {% render 'swatch', swatch: option.selected_value.swatch %} {% endcomment %}
                </span>
              {%- endif -%}
              <select
                id="Option-{{ section.id }}-{{ forloop.index0 }}"
                class="form-control form-control--select"
                name="options[{{ option.name | escape }}]"
                form="{{ product_form_id }}"
              >
                {% render 'product-variant-options',
                  product: product,
                  option: option,
                  block: block,
                  picker_type: picker_type
                %}
              </select>
              {%- render 'icon-caret-down' -%}
            </div>
        {%- endcase -%}
      </{{ tag_fieldset }}>
    {%- endfor -%}
    <script type="application/json" data-selected-variant>
      {{ product.selected_or_first_available_variant | json }}
    </script>
    {%- comment -%}
      Variant cache read by product-info.js to patch price / button / media / badges in the same frame
      as the click, before the section render settles them.

      Trimmed on purpose rather than `product.variants | json`: that ships fields nothing here reads,
      and `in_stock` has to be precomputed because `inventory_quantity` and `inventory_policy` are
      absent from variant JSON — a `continue` policy variant is `available` while its badge must still
      read sold out (see product-badges.liquid).

      Two shapes, because Liquid hands over only the first 250 variants:

      - At or below 250 the array is complete, so cache all of it. Any combination, and any number of
        option changes in a row, is answered without a round trip.
      - Past 250 the array is a prefix, and caching it would weigh 64KB in every page load to answer
        about a fifth of the clicks on a 1,400-variant product — an arbitrary fifth, since Shopify
        picks it. Cache the neighbourhood instead: the variant behind each option value, which is the
        one the shopper reaches by changing a single option from where they are. Measured on that
        product: 10KB, and it spans the whole option range (1 CT through 10 CT) rather than stopping
        at the cap, because product_option_value.variant is resolved server side rather than by
        iterating the truncated array.

      The neighbourhood only answers one change at a time. A second click landing before the section
      render re-centres it misses, and falls to sections/variant-data.liquid exactly as it does today.
      Option values with no variant behind them resolve to nothing and are skipped; clicking one has
      nothing to show anyway, and the render marks it unavailable.

      paginate.items, not product.variants.size: `.size` is the size of the capped array and so never
      exceeds 250, which cannot tell a truncated product from one that genuinely has 250 variants.
      paginate.items reports the real total (measured: 1400 where `.size` says 250).
    {%- endcomment -%}
    {%- paginate product.variants by 250 -%}
      <script type="application/json" data-variants-cache>
        [
          {%- if paginate.items <= 250 -%}
            {%- for variant in product.variants -%}
              {%- render 'variant-json', variant: variant -%}
              {%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          {%- else -%}
            {%- assign first_entry = true -%}
            {%- for option in product.options_with_values -%}
              {%- for value in option.values -%}
                {%- if value.variant -%}
                  {%- unless first_entry -%},{%- endunless -%}
                  {%- render 'variant-json', variant: value.variant -%}
                  {%- assign first_entry = false -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endfor -%}
          {%- endif -%}
        ]
      </script>
    {%- endpaginate -%}
  </variant-selects>
  {%- if size_chart_content != blank -%}
    <div id="SizeChart-{{ section.id }}">
      <basic-modal id="{{ size_chart_modal_id }}" class="drawer modal" style="--modal-width: 77rem;">
        <div class="fixed-overlay" aria-controls="{{ size_chart_modal_id }}"></div>
        <div class="drawer__inner">
          <button
            class="drawer__close-btn"
            aria-controls="{{ size_chart_modal_id }}"
            aria-label="{{ 'accessibility.close' | t }}"
          >
            {% render 'icon-close' %}
          </button>
          <div class="drawer__body v-scrollable h-full rte">
            {{ size_chart_content }}
          </div>
        </div>
      </basic-modal>
    </div>
  {%- endif -%}
{%- endunless -%}
